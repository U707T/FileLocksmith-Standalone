/* 由 CMake 从仓库根目录的 VERSION 文件生成，请勿直接修改。
   This header is shared by the C++ sources and by res/resource.rc, so keep it
   plain (no wide literals, no #pragma once). */
#ifndef FL_VERSION_H
#define FL_VERSION_H

#define FL_VERSION_STRING "@FL_VERSION@"
#define FL_VERSION_MAJOR @FL_VERSION_MAJOR@
#define FL_VERSION_MINOR @FL_VERSION_MINOR@
#define FL_VERSION_PATCH @FL_VERSION_PATCH@

#endif
