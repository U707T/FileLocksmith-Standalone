#include <windows.h>
#include <version.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FL_VERSION_MAJOR,FL_VERSION_MINOR,FL_VERSION_PATCH,0
 PRODUCTVERSION FL_VERSION_MAJOR,FL_VERSION_MINOR,FL_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FileLocksmith (standalone) - find out what is locking a file"
            VALUE "FileVersion", FL_VERSION_STRING
            VALUE "InternalName", "FileLocksmith.exe"
            VALUE "OriginalFilename", "FileLocksmith.exe"
            VALUE "ProductName", "FileLocksmith standalone"
            VALUE "ProductVersion", FL_VERSION_STRING
            VALUE "LegalCopyright", "Based on Microsoft PowerToys FileLocksmith (MIT License)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
